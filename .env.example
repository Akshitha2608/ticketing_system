# Neon Console > Project > Connect > pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
# Generate a long random value; do not commit real secrets
SECRET_KEY=replace-with-a-long-random-secret
# First administrator is created automatically when both values are set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=false
